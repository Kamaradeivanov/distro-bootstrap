### General ###

alias ls='ls --color=auto'
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'
alias grep='grep --color=auto'
alias docker='podman'
alias egpg='export GPG_TTY=$(tty)'
alias hist='history -iD'   # history with start time and duration of each command
alias watch='watch '
alias zshconfig='${EDITOR:-nano} ~/.zshrc'

### Git ###
# Same names as the oh-my-zsh git plugin, so muscle memory keeps working.

git_current_branch() { git branch --show-current 2>/dev/null; }
git_main_branch() {
  local b
  for b in main master trunk; do
    git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }
  done
  echo main
}
git_develop_branch() {
  local b
  for b in develop dev devel; do
    git show-ref -q --verify "refs/heads/$b" && { echo "$b"; return; }
  done
  echo develop
}

alias g='git'

# status / log / diff
alias gst='git status'
alias gss='git status --short'
alias gsb='git status --short --branch'
alias glo='git log --oneline --decorate'
alias glog='git log --oneline --decorate --graph'
alias gloga='git log --oneline --decorate --graph --all'
alias gd='git diff'
alias gds='git diff --staged'

# add / commit
alias ga='git add'
alias gaa='git add --all'
alias gapa='git add --patch'
alias gc='git commit -m '
alias gca='git commit --verbose --all'
alias 'gc!'='git commit --verbose --amend'
alias 'gcn!'='git commit --verbose --no-edit --amend'
alias 'gcan!'='git commit --verbose --all --no-edit --amend'

# branches
alias gb='git branch'
alias gba='git branch --all'
alias gbd='git branch --delete'
alias gbD='git branch --delete --force'
alias gco='git checkout'
alias gcb='git checkout -b '
alias gcm='git checkout $(git_main_branch)'
alias gcd='git checkout $(git_develop_branch)'
alias gsw='git switch'
alias gswc='git switch --create'

# fetch / pull
alias gf='git fetch'
alias gfa='git fetch --all --tags --prune'
alias gfo='git fetch origin'
alias gl='git pull'
alias gpr='git pull --rebase'
alias ggpull='git pull origin "$(git_current_branch)"'

# push
alias gp='git push'
alias gpf='git push -f'
alias gpsup='git push --set-upstream origin $(git_current_branch)'
alias gpsuo='git push --set-upstream origin '
alias gpsci='git push -o ci.skip'
alias ggpush='git push origin "$(git_current_branch)"'

# rebase / merge / reset
alias grb='git rebase'
alias grba='git rebase --abort'
alias grbc='git rebase --continue'
alias grbi='git rebase --interactive'
alias grbm='git rebase $(git_main_branch)'
alias grl='git rebase -i HEAD~2'
alias grod='git rebase origin/develop'
alias grom='git rebase origin/master'
alias gm='git merge'
alias gma='git merge --abort'
alias grh='git reset'
alias grhh='git reset --hard'
alias grs='git restore'
alias grst='git restore --staged'

# stash / cherry-pick / remote
alias gsta='git stash push'
alias gstp='git stash pop'
alias gstl='git stash list'
alias gcp='git cherry-pick'
alias gcpa='git cherry-pick --abort'
alias gcpc='git cherry-pick --continue'
alias gr='git remote'
alias grv='git remote --verbose'
alias gcl='git clone --recurse-submodules'

alias gitlab-runner-local='docker run --rm -it -v "$PWD":"$PWD" --workdir "$PWD" -v /var/run/docker.sock:/var/run/docker.sock gitlab/gitlab-runner exec docker --docker-privileged --docker-pull-policy="always" --docker-volumes /var/run/docker.sock:/var/run/docker.sock'

### Kubernetes ###

alias k='kubectl'
alias kk='k krew'
alias kc='kubecolor'
alias kctx='k ctx'
alias kd='k describe'
alias kg='k get'
alias kgp='k get pods'
alias kl='k logs'
alias kns='k ns'
alias wk='watch k'
alias wkg='watch kg'

### Terraform / OpenTofu ###

alias tf='tofu'
alias tfa='tf apply'
alias tfi='tf init'
alias tfp='tf plan'

### JSON ###

alias norg='gron --ungron'
alias ungron='gron --ungron'
